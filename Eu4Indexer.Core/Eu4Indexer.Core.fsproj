<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AppInfo.fs" />
    <Compile Include="AppPaths.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="Updater.fs" />
    <Compile Include="AgentInstall.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="GameAdapter.fs" />
    <Compile Include="ModDescriptor.fs" />
    <Compile Include="Launcher.fs" />
    <Compile Include="IndexInputs.fs" />
    <Compile Include="Discovery.fs" />
    <Compile Include="ConfigCatalog.fs" />
    <Compile Include="FileResolution.fs" />
    <Compile Include="Parsing.fs" />
    <Compile Include="ScriptTree.fs" />
    <Compile Include="Extractors/Support.fs" />
    <Compile Include="Extractors/Events.fs" />
    <Compile Include="Extractors/Missions.fs" />
    <Compile Include="Extractors/Decisions.fs" />
    <Compile Include="Extractors/Modifiers.fs" />
    <Compile Include="Extractors/FocusTrees.fs" />
    <Compile Include="Extractors/Ideas.fs" />
    <Compile Include="Extractors/Generic.fs" />
    <Compile Include="Extractors/Defines.fs" />
    <Compile Include="OverrideResolution.fs" />
    <Compile Include="ReferenceExtractor.fs" />
    <Compile Include="Localisation.fs" />
    <Compile Include="Database/Schema.fs" />
    <Compile Include="Database/Dialect.fs" />
    <Compile Include="Database/PostgresSchema.fs" />
    <Compile Include="Database/Writer.fs" />
    <Compile Include="Pipeline.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../external/cwtools/CWTools/CWTools.fsproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Eu4Indexer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../external/cwtools-eu4-config/**/*" Exclude="../external/cwtools-eu4-config/.git;../external/cwtools-eu4-config/.github/**/*;../external/cwtools-eu4-config/.gitignore;../external/cwtools-eu4-config/.gitattributes">
      <Link>rules/eu4/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../external/cwtools-hoi4-config/**/*" Exclude="../external/cwtools-hoi4-config/.git;../external/cwtools-hoi4-config/.github/**/*;../external/cwtools-hoi4-config/.gitignore;../external/cwtools-hoi4-config/.gitattributes">
      <Link>rules/hoi4/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="VerifyBundledRules" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../external/cwtools-eu4-config/scopes.cwt') Or !Exists('../external/cwtools-hoi4-config/Config/scopes.cwt')" Text="Game rules are missing. Run git submodule update --init --recursive before building." />
  </Target>

</Project>
